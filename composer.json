{
  "name": "patryk-przybysz/image-gallery",
  "description": "A PHP image gallery with authentication, uploads, watermarking, search, and pagination.",
  "license": "MIT",
  "authors": [
    {
      "name": "Patryk Przybysz"
    }
  ],
  "require": {
    "php": "^8.4",
    "mongodb/mongodb": "^2.2",
    "chubbyphp/chubbyphp-parsing": "^2.8"
  },
  "require-dev": {
    "pestphp/pest": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "./src"
    },
    "files": [
      "./src/Utils/ArrayFunctions.php",
      "./resources/views/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest --group=unit"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
