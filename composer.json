{
  "name": "patryk-przybysz/image-gallery",
  "description": "A PHP image gallery with authentication, uploads, watermarking, search, and pagination.",
  "license": "MIT",
  "authors": [
    {
      "name": "Patryk Przybysz"
    }
  ],
  "require": {
    "php": "^8.4",
    "mongodb/mongodb": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "./src"
    },
    "files": [
      "./src/Utils/ArrayFunctions.php",
      "./resources/views/functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true
  }
}
